# Copy to ~/.tarobot/integrations.env, chmod 600. Fill secrets locally only.
# Values are literal: no shell expansion, command substitution or ~ expansion.
# Explicit process env > bot.env > legacy lark.env > this file > legacy shared.env.

# Web search: either provider works; configure both for fallback / verification.
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# Local voice (defaults shown). CLI paths below are needed only for custom installs.
ASR_HTTP_URL=http://127.0.0.1:8412/transcribe
# ASR_CLI_PYTHON=/absolute/path/qwen3-asr/.venv/bin/python
# ASR_CLI_SCRIPT=/absolute/path/qwen3-asr/transcribe.py
# ASR_MODEL_PATH=/absolute/path/Qwen3-ASR-0.6B
ASR_MAX_AUDIO_SECONDS=300
ASR_CLI_CHUNK_SECONDS=45

# Long media: enable after install-tingwu-asr.sh and private configure_env.sh.
# TINGWU_ASR_DIR=/absolute/private/path/tingwu_asr
# For unmanaged workers: auto (default), local, or cloud. Host settings override this.
# ASR_CLOUD_MODE=auto
ASR_CLOUD_THRESHOLD_SECONDS=900
ASR_CLOUD_JOB_RETENTION_DAYS=7
# No Alibaba access keys here. They belong ONLY in Tingwu's private .env.local.
