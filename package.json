{
  "name": "tarobot",
  "version": "1.1.0",
  "description": "TaroBird: desktop and mobile AI workspace with a self-hosted Hub, multi-engine Bots and optional VPS relay.",
  "private": true,
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/cloveric/tarobird#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloveric/tarobird.git"
  },
  "bugs": {
    "url": "https://github.com/cloveric/tarobird/issues"
  },
  "keywords": [
    "codex",
    "claude-code",
    "kimi-code",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "ai-agents",
    "multi-agent",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "tarobot": "bin/tarobot.mjs",
    "tarobird": "bin/tarobot.mjs"
  },
  "tarobotHostUpdate": {
    "format": 1,
    "minHubSchema": 1,
    "maxHubSchema": 25
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build-standalone.mjs",
    "build:web": "vite build web && node scripts/inline-web.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "smoke:claude-auth": "bash scripts/smoke-claude-auth.sh",
    "test": "vitest run && node --test scripts/macos-artifact-paths.test.mjs scripts/check-upload-privacy.test.mjs scripts/release-version.test.mjs",
    "test:watch": "vitest",
    "verify:sqlite-driver": "node scripts/verify-sqlite-driver.mjs",
    "verify:deepseek-plugin": "npm --prefix deepseek-harness-plugin run verify",
    "publish:deepseek-plugin": "bash scripts/publish-deepseek-harness-plugin.sh",
    "pack:standalone": "npm run build && node scripts/package-standalone.mjs",
    "prepack": "node scripts/verify-host-launcher.mjs",
    "privacy:setup": "node scripts/setup-privacy-hooks.mjs",
    "privacy:staged": "node scripts/check-git-identity.mjs && node scripts/check-upload-privacy.mjs staged && node scripts/check-secrets.mjs staged",
    "privacy:test": "node --test scripts/privacy-guards.node-test.mjs scripts/check-upload-privacy.test.mjs",
    "version:check": "node scripts/release-version.mjs check",
    "version:sync": "node scripts/release-version.mjs sync",
    "version:bump": "node scripts/release-version.mjs bump"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.4.0",
    "@peculiar/x509": "3.1.0",
    "@types/adm-zip": "0.6.0",
    "adm-zip": "0.6.1",
    "croner": "11.0.0",
    "cross-spawn": "7.0.6",
    "htmlparser2": "12.0.0",
    "https-proxy-agent": "9.1.0",
    "pdf-parse": "^2.4.5",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "0.2.2",
    "smol-toml": "1.9.1",
    "sqlite3": "6.0.1",
    "web-push": "3.6.7",
    "ws": "8.22.1",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "axios": "1.20.0",
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "protobufjs": "7.6.5",
    "vite": "$vite"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^24.6.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "0.28.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "4.1.12"
  },
  "files": [
    "bin",
    "dist/src",
    "dist/deepseek-harness-plugin/src",
    "dist/relay-runtime.mjs",
    "dist/standalone-graph.json",
    "client/dist",
    "integrations/.env.example",
    "integrations/qwen3-asr/server.py",
    "integrations/qwen3-asr/transcribe.py",
    "integrations/qwen3-asr/requirements.txt",
    "integrations/qwen3-asr/README.md",
    "integrations/tingwu-asr/tingwu_transcribe.py",
    "integrations/tingwu-asr/configure_env.sh",
    "integrations/tingwu-asr/requirements.txt",
    "integrations/tingwu-asr/.env.example",
    "integrations/tingwu-asr/README.md",
    "integrations/tingwu-asr/README.zh-CN.md",
    "scripts/install-qwen-asr.sh",
    "scripts/qwen-asr-install.py",
    "scripts/install-tingwu-asr.sh",
    "scripts/search-mcp.mjs",
    "scripts/check-integrations.mjs",
    "scripts/install-scrapling.sh",
    "skills/scrapling/SKILL.md",
    "scripts/verify-host-launcher.mjs",
    "docs/integrations.md",
    "docs/search-mcp.md",
    "LICENSING.md",
    "deepseek-harness-plugin/LICENSE",
    "scripts/install-skills.sh",
    "skills/baoyu-design/LICENSE",
    "skills/baoyu-design/NOTICE.md",
    "skills/baoyu-design/SKILL.md",
    "skills/baoyu-design/UPSTREAM.json",
    "skills/baoyu-design/references/brand-colors.md",
    "skills/baoyu-design/references/brand-typography.md",
    "skills/baoyu-design/references/craft.md",
    "skills/baoyu-design/references/design-system-components.md",
    "skills/baoyu-design/references/diagrams.md",
    "skills/baoyu-design/references/format.md",
    "skills/baoyu-design/references/google-fonts-families.json",
    "skills/baoyu-design/references/google-fonts-notices.json",
    "skills/baoyu-design/references/google-fonts-reserved.json",
    "skills/baoyu-design/references/make-from-this.md",
    "skills/baoyu-design/references/print.md",
    "skills/baoyu-design/references/questions.md",
    "skills/baoyu-design/references/view-state.md",
    "skills/baoyu-ppt/LICENSE",
    "skills/baoyu-ppt/NOTICE.md",
    "skills/baoyu-ppt/SKILL.md",
    "skills/baoyu-ppt/UPSTREAM.json",
    "skills/baoyu-ppt/references/craft.md",
    "skills/baoyu-ppt/references/deck-files.md",
    "skills/baoyu-ppt/references/diagram-recipes.md",
    "skills/baoyu-ppt/references/diagrams.md",
    "skills/baoyu-ppt/references/fonts.md",
    "skills/baoyu-ppt/references/format.md",
    "skills/baoyu-ppt/references/google-fonts-families.json",
    "skills/baoyu-ppt/references/google-fonts-notices.json",
    "skills/baoyu-ppt/references/google-fonts-reserved.json",
    "skills/baoyu-ppt/references/images.md",
    "skills/baoyu-ppt/references/layout.md",
    "skills/baoyu-ppt/references/photo-library.md",
    "skills/baoyu-ppt/references/questions.md",
    "skills/baoyu-ppt/references/styles.md",
    "skills/baoyu-ppt/references/view-state.md"
  ],
  "tarobotHubSchema": 25,
  "tarobotHostCapabilities": [
    "service-extra-environment-v1",
    "windows-state-admission-v1"
  ]
}
