{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client"
    ],
    "ignoreDeprecations": "6.0",
    "paths": {
      "zod": [
        "./node_modules/zod"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src"
  ]
}
