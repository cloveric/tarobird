{
  "name": "tarocub-client",
  "version": "1.4.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-translations.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:audit-runner": "node --test scripts/native-audit-runner.test.mjs",
    "test:electron": "node --import tsx --test electron/tests/*.test.mjs",
    "desktop:dev": "node scripts/electron-dev.mjs",
    "desktop:build": "node scripts/electron-build.mjs",
    "desktop:windows": "node scripts/windows-build.mjs",
    "desktop:macos": "node scripts/macos-build.mjs",
    "mobile:sync": "node scripts/widget-native-guard.mjs && cap sync",
    "capacitor:sync:before": "node scripts/widget-native-guard.mjs",
    "capacitor:copy:before": "node scripts/widget-native-guard.mjs",
    "capacitor:copy:after": "node scripts/mobile-csp.mjs",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "desktop:release": "node scripts/electron-build.mjs --production",
    "visual:fixtures": "node scripts/visual-fixtures.mjs",
    "test:webkit": "playwright test --config playwright.webkit.config.ts",
    "desktop:prepare": "npm run build --prefix .. && npm run build && node ../scripts/prepare-desktop-host.mjs",
    "ios:doctor": "node scripts/ios-build.mjs --doctor",
    "ios:build": "node scripts/ios-build.mjs",
    "test:ios-release": "node --test scripts/ios-release-plan.test.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "10.0.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/privacy-screen": "2.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@excalidraw/excalidraw": "0.18.1",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@tanstack/react-virtual": "3.14.26",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@tauri-apps/plugin-deep-link": "2.6.3",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-global-shortcut": "2.4.1",
    "@tauri-apps/plugin-notification": "2.8.1",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "hast-util-to-jsx-runtime": "2.3.7",
    "idb": "8.0.4",
    "jsqr": "1.4.0",
    "katex": "0.19.1",
    "linkedom": "0.18.15",
    "lucide-react": "1.71.0",
    "mammoth": "1.13.0",
    "micromark-core-commonmark": "2.0.4",
    "pdfjs-dist": "6.5.438",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "vditor": "4.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@electron/osx-sign": "2.7.2",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/hast": "3.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "katex": "$katex",
    "lodash-es": "4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    }
  }
}
