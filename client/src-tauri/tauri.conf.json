{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaroBird",
  "version": "1.3.1",
  "identifier": "com.tarobot.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TaroBird",
        "width": 1200,
        "height": 820,
        "minWidth": 600,
        "minHeight": 480,
        "dragDropEnabled": false,
        "backgroundThrottling": "disabled",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 30
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; worker-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src blob: widget: http://widget.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "publisher": "tarocub",
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "resources": {
      "host/": "host/"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tarocub"
        ]
      }
    },
    "updater": {
      "endpoints": [],
      "pubkey": "",
      "requireSignedVersion": true,
      "allowDowngrades": false
    }
  }
}
