{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaroBot Screenshot Acceptance",
  "version": "1.0.0",
  "identifier": "com.tarocub.screenshot-audit",
  "build": {
    "frontendDist": "../screenshot-ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; img-src data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../icons/32x32.png"
    ]
  }
}
